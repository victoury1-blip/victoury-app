{
  "functions": {
    "api/ozone-check.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/chic-proxy.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "comment": "Le shell HTML et le service worker ne doivent JAMAIS être servis depuis un cache : un index.html périmé réclame des fichiers supprimés par le déploiement suivant, et l'application reste bloquée sur une erreur de chargement que vider le cache du service worker ne répare pas — le cache HTTP du navigateur, lui, garde l'ancienne page.",
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/version.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/ozone-client/:path*", "destination": "https://client.ozoneexpress.ma/:path*" },
    { "source": "/ozone-api/:path*", "destination": "https://api.ozonexpress.ma/:path*" },
    { "source": "/wc-api/:path*", "destination": "https://victoury-maroc.com/:path*" },
    { "source": "/chic-api/:path*", "destination": "https://www.chic-affiliate.com/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
