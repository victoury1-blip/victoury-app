{
  "rewrites": [
    { "source": "/wc-api/:path*", "destination": "https://victoury-maroc.com/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate" },
        { "key": "Cloudflare-CDN-Cache-Control", "value": "max-age=60" },
        { "key": "CDN-Cache-Control", "value": "max-age=60" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate" },
        { "key": "Cloudflare-CDN-Cache-Control", "value": "max-age=60" },
        { "key": "CDN-Cache-Control", "value": "max-age=60" }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate" },
        { "key": "Cloudflare-CDN-Cache-Control", "value": "max-age=60" },
        { "key": "CDN-Cache-Control", "value": "max-age=60" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/relance-paniers", "schedule": "*/15 * * * *" }
  ]
}
